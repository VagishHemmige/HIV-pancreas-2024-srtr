# R, RStudio and Positron
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.httr-oauth
.DS_Store

# Quarto. docs/ is the rendered site. It is not tracked: a GitHub Actions
# workflow renders the site and publishes it to the gh-pages branch.
/.quarto/
**/*.quarto_ipynb
/docs/

# Credentials
.Renviron
.env
*.pem
*.key

# Data files. Data live outside the repository; this is a safety net, not access control.
/data-raw/
*.csv
*.xlsx
*.xls
*.rds
*.rda
*.sas7bdat
*.sas7bcat
*.xpt
*.dta
*.sav
*.parquet
*.feather
*.arrow
*.fst

# Outputs from SRTR data, ignored until reviewed against the SRTR data use
# agreement's disclosure rules (see AGENTS.md, "Outputs"). Remove these lines
# only when that review clears them.
# Removing them does not track tables saved as .csv or .rds: the data-format
# patterns above still hide those, so cleared tables need their own exceptions.
/figures/
/tables/

# Approved public files: add narrow exceptions here, never a whole format.
# !tests/fixtures/synthetic.csv

